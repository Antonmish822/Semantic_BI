PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?deal ?title ?assigned_to ?manager_name
                ?created_at ?last_activity_time
WHERE {
  VALUES ?selected_project { {{selected_project}} }
  GRAPH ?deal_graph {
    ?deal b24:stageSemantic "P" ;
          b24:createdAt ?created_raw ;
          b24:categoryCode ?category_code .
    OPTIONAL { ?deal b24:title ?title }
    OPTIONAL { ?deal b24:assignedTo ?assigned_to }
    OPTIONAL { ?deal b24:lastActivityTime ?last_activity_time }
  }
  FILTER(STRSTARTS(STR(?deal_graph), {{graph_prefix}})
         && CONTAINS(STR(?deal_graph), ":deal:"))
  FILTER(?selected_project = "all"
         || STR(?category_code) = ?selected_project)
  BIND(xsd:dateTime(STR(?created_raw)) AS ?created_at)

  FILTER NOT EXISTS {
    GRAPH ?activity_graph {
      ?activity b24:owner ?deal ;
                b24:ownerTypeId "2" ;
                b24:createdAt ?activity_raw .
    }
    FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
           && CONTAINS(STR(?activity_graph), ":activity:"))
    BIND(xsd:dateTime(STR(?activity_raw)) AS ?activity_at)
    FILTER(?activity_at >= NOW() - "P7D"^^xsd:dayTimeDuration
           && ?activity_at <= NOW())
  }

  OPTIONAL {
    GRAPH ?user_graph { ?assigned_to b24:fullName ?manager_name }
    FILTER(STRSTARTS(STR(?user_graph), {{graph_prefix}})
           && CONTAINS(STR(?user_graph), ":user:"))
  }
}
ORDER BY DESC(?created_at)
LIMIT 30
