PREFIX b24: <https://example.org/bitrix24#>

SELECT DISTINCT ?category_code ?category_name
WHERE {
  GRAPH ?category_graph {
    ?category b24:name ?category_name .
  }
  FILTER(STRSTARTS(STR(?category_graph), {{graph_prefix}})
         && CONTAINS(STR(?category_graph), ":category:"))
  BIND(STRAFTER(STR(?category), "https://example.org/bitrix24/category/")
       AS ?category_code)
  FILTER(?category_code != "")
}
ORDER BY ?category_name ?category_code
