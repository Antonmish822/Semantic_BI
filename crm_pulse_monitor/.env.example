# GraphDB repository used by the CRM pulse monitor.
RDF_BACKEND=graphdb
RDF_URL=http://127.0.0.1:7200
GRAPHDB_REPOSITORY=fuseki_migration_monitor
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=45
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru:

# The monitor binds to loopback by default and does not expose credentials to the browser.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8082
