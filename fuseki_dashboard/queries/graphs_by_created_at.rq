# Count distinct graphs by the date recorded in b24:createdAt.
SELECT ?day (COUNT(DISTINCT ?g) AS ?graphs) WHERE {
  GRAPH ?g {
    ?s <https://example.org/bitrix24#createdAt> ?date
  }
  FILTER(STRSTARTS(STR(?g), {{graph_prefix}}))
  FILTER(isLiteral(?date) && REGEX(STR(?date), "^[0-9]{4}-[0-9]{2}-[0-9]{2}"))
  BIND(SUBSTR(STR(?date), 1, 10) AS ?day)
}
GROUP BY ?day
ORDER BY ?day
