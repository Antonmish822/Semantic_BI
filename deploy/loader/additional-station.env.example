# Copy to additional-station.env, fill in local values, then chmod 600.
# This file is sourced by migrate_additional_station_v2.sh.
YC_PROFILE=semantic-bi-backup-readonly
BACKUP_BUCKET="<private-backup-bucket>"
BACKUP_PREFIX=semantic-bi/v2-parallel

CONFIG_FILE="$PROJECT_DIR/local-data/v2-parallel/container-loader.yaml"
STATE_DIR="$PROJECT_DIR/local-data/v2-parallel/container-state"
BACKUP_DIR="$PROJECT_DIR/local-data/v2-parallel/container-backups"
MONITOR_ENV_FILE="$PROJECT_DIR/rdf_store_monitor/.env.graphdb"

# Names of the currently running containers on this computer.
OLD_LOADER_NAME=semantic_bi_v2_parallel_loader
OLD_MONITOR_NAME=semantic_bi_v2_parallel_monitor
MONITOR_NETWORK=graphdb_default
MONITOR_PORT=8081
