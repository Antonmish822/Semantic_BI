# Use the same published release tag for loader and monitor.
LOADER_IMAGE_TAG=REPLACE_WITH_PUBLISHED_TAG
MONITOR_IMAGE_TAG=REPLACE_WITH_PUBLISHED_TAG
LOADER_UID=10001
LOADER_GID=10001
GRAPHDB_DOCKER_NETWORK=graphdb_default
LOADER_CONFIG_FILE=/etc/semantic-bi/loader.yaml
MONITOR_ENV_FILE=/etc/semantic-bi/monitor.env
LOADER_STATE_VOLUME=semantic_bi_graphdb_state
GRAPHDB_MONITOR_PORT=8081
