@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# cccr_core is a static library; SaxonC-HE is required at final link.
# glaze is header-only and linked PRIVATE — not required by consumers of the
# installed package unless they compile against glaze-using headers.
find_dependency(SaxonCHE @CCCR_CONFIG_SAXON_CHE_VERSION@ EXACT)

# Redland stack: system build → pkg-config shared libs; vendored build →
# static archives installed next to CCCR under the same prefix.
set(_CCCR_REDLAND_VENDORED "@CCCR_CONFIG_REDLAND_VENDORED@")
set(_CCCR_REDLAND_STATIC "@CCCR_CONFIG_REDLAND_STATIC@")

if(_CCCR_REDLAND_VENDORED AND _CCCR_REDLAND_STATIC)
  get_filename_component(_CCCR_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
  set(_CCCR_REDLAND_LIBDIR "${_CCCR_PREFIX}/@CMAKE_INSTALL_LIBDIR@")
  set(_CCCR_REDLAND_INCLUDEDIR "${_CCCR_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@")

  if(NOT TARGET Redland::raptor2)
    add_library(Redland::raptor2 STATIC IMPORTED)
    set_target_properties(Redland::raptor2 PROPERTIES
      IMPORTED_LOCATION "${_CCCR_REDLAND_LIBDIR}/libraptor2.a"
      INTERFACE_INCLUDE_DIRECTORIES
        "${_CCCR_REDLAND_INCLUDEDIR}/raptor2"
    )
  endif()
  if(NOT TARGET Redland::rasqal)
    add_library(Redland::rasqal STATIC IMPORTED)
    set_target_properties(Redland::rasqal PROPERTIES
      IMPORTED_LOCATION "${_CCCR_REDLAND_LIBDIR}/librasqal.a"
      INTERFACE_INCLUDE_DIRECTORIES
        "${_CCCR_REDLAND_INCLUDEDIR}/rasqal;${_CCCR_REDLAND_INCLUDEDIR}/raptor2"
      INTERFACE_LINK_LIBRARIES Redland::raptor2
    )
  endif()
  if(NOT TARGET Redland::redland)
    add_library(Redland::redland STATIC IMPORTED)
    set_target_properties(Redland::redland PROPERTIES
      IMPORTED_LOCATION "${_CCCR_REDLAND_LIBDIR}/librdf.a"
      INTERFACE_INCLUDE_DIRECTORIES
        "${_CCCR_REDLAND_INCLUDEDIR};${_CCCR_REDLAND_INCLUDEDIR}/rasqal;${_CCCR_REDLAND_INCLUDEDIR}/raptor2"
      INTERFACE_LINK_LIBRARIES Redland::rasqal
    )
  endif()
  if(NOT TARGET cccr::redland)
    add_library(cccr::redland INTERFACE IMPORTED)
    set_target_properties(cccr::redland PROPERTIES
      INTERFACE_LINK_LIBRARIES Redland::redland
    )
  endif()
else()
  find_dependency(PkgConfig)
  pkg_check_modules(CCCR_REDLAND_PC REQUIRED IMPORTED_TARGET redland)
  pkg_check_modules(CCCR_RASQAL_PC REQUIRED IMPORTED_TARGET rasqal)
  pkg_check_modules(CCCR_RAPTOR2_PC REQUIRED IMPORTED_TARGET raptor2)
  if(NOT TARGET Redland::raptor2)
    add_library(Redland::raptor2 INTERFACE IMPORTED)
    set_target_properties(Redland::raptor2 PROPERTIES
      INTERFACE_LINK_LIBRARIES PkgConfig::CCCR_RAPTOR2_PC)
  endif()
  if(NOT TARGET Redland::rasqal)
    add_library(Redland::rasqal INTERFACE IMPORTED)
    set_target_properties(Redland::rasqal PROPERTIES
      INTERFACE_LINK_LIBRARIES
        "PkgConfig::CCCR_RASQAL_PC;Redland::raptor2")
  endif()
  if(NOT TARGET Redland::redland)
    add_library(Redland::redland INTERFACE IMPORTED)
    set_target_properties(Redland::redland PROPERTIES
      INTERFACE_LINK_LIBRARIES
        "PkgConfig::CCCR_REDLAND_PC;Redland::rasqal;Redland::raptor2")
  endif()
  if(NOT TARGET cccr::redland)
    add_library(cccr::redland INTERFACE IMPORTED)
    set_target_properties(cccr::redland PROPERTIES
      INTERFACE_LINK_LIBRARIES Redland::redland)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CCCRTargets.cmake")

# cccr_core is static: consumers must link Redland + Saxon at final link time.
# These were BUILD_INTERFACE-only during the CCCR build so install(EXPORT) stays
# free of non-exported imported targets.
if(TARGET cccr::core)
  target_link_libraries(cccr::core INTERFACE
      cccr::redland
      SaxonCHE::saxonc-he
  )
endif()

check_required_components(CCCR)
