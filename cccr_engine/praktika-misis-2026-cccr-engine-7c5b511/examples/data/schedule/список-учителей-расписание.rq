PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
prefix : <https://rdf.lipers24.ru/schema/>
prefix тип: <https://rdf.lipers24.ru/онтология/>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?about (CONCAT(?фамилия, " ", SUBSTR(?имя, 1, 1), ".", SUBSTR(?отчество, 1,1), ".") AS ?id)
WHERE
{
  GRAPH ?g1{
    ?about rdf:type тип:Учитель;
      :фамилия ?фамилия;
       :имя ?имя;
       :отчество ?отчество.
  }
}
ORDER BY ?фамилия
