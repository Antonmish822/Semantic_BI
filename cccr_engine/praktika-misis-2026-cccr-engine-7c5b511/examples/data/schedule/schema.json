{
  "description": {
    "about": {
      "compute": {
        "xquery": "concat('https://rdf.lipers24.ru/ресурсы/Расписание#', /file/@year, '-', /file/@week)"
      }
    },
    "properties": [
      {
        "QName": {
          "NameSpace": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
          "PrefixedName": "rdf:type"
        },
        "URI": "https://rdf.lipers24.ru/онтология/Расписание"
      },
      {
        "QName": {
          "NameSpace": "https://rdf.lipers24.ru/schema/",
          "PrefixedName": "lipers24:наборУроковУчителя"
        },
        "description": {
          "context": {
            "subject": {
              "compute": {
                "xquery": "/file/table[1]/row[position()>3]"
              }
            }
          },
          "about": {
            "compute": {
              "xquery": "concat('https://rdf.lipers24.ru/ресурсы/учителя#', encode-for-uri(./cell[@label='Учитель']/text()))"
            }
          },
          "properties": [
            {
              "QName": {
                "NameSpace": "https://rdf.lipers24.ru/schema/",
                "PrefixedName": "lipers24:урок"
              },
              "description": {
                "context": {
                  "subject": {
                    "compute": {
                      "xquery": "./cell[@label][position()>2][normalize-space(string())]"
                    }
                  }
                },
                "about": {
                  "compute": {
                    "xquery": "concat('https://rdf.lipers24.ru/ресурсы/уроки#', encode-for-uri(../cell[@label='Учитель']/text()), '-', @label)"
                  }
                },
                "properties": [
                  {
                    "QName": {
                      "NameSpace": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
                      "PrefixedName": "rdf:type"
                    },
                    "URI": "https://rdf.lipers24.ru/онтология/Урок"
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:фио"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "../cell[@label='Учитель']/text()"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:учебныйГод"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "/file/@year/string()"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:учебныйНомерНедели"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "/file/@week/string()"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:номерДняНедели"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "tokenize(@label, '-')[1]"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:номерУрока"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "tokenize(@label, '-')[2]"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:класс"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "tokenize(text(), ';')[1]"
                      }
                    }
                  },
                  {
                    "QName": {
                      "NameSpace": "https://rdf.lipers24.ru/schema/",
                      "PrefixedName": "lipers24:предмет"
                    },
                    "literal": {
                      "compute": {
                        "xquery": "tokenize(text(), ';')[2]"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
