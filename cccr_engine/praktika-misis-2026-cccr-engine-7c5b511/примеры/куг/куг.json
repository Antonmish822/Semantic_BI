{
    "version":"2.4",
    "description":{
        "context":{
            "subject":{
                "compute":{
                    "xquery":"./file/table[@label='КУГ']"
                }
            }
        },
        "about":{
            "compute":{
                "xquery":[
                    "replace(./file/@URI/data(),  '.*?/КУГ-(\\d{4})-(\\d{4}).xlsx', '$1-$2')",
                    "'https://rdf.lipers24.ru/ресурсы/КУГ#' || ."
                ]
            }
        },
        "properties":[
            {
                "QName":{
                    "NameSpace":"http://www.w3.org/1999/02/22-rdf-syntax-ns#",
                    "PrefixedName":"rdf:type"
                },
                "URI": "https://rdf.lipers24.ru/онтология/КУГ"
            },
            {
                "context":{
                    "predicates":{
                        "compute":{
                            "xquery":"./subject/table/row"
                        }
                    }
                },
                "QName":{
                    "NameSpace":"https://rdf.lipers24.ru/schema/",
                    "PrefixedName":"lipers24:дата"
                },
                "description":{
                    "context":{
                        "subject":{
                            "compute":{
                                "xquery":"./predicate/row"
                            }
                        },
                        "дата":{
                            "compute":{
                                "xquery":
                                [
                                    "./predicate/row/cell[@label='Дата']/text()"
                                ]
                            }
                        }
                    },
                    "about":{
                        "compute":{
                            "xquery": "'https://rdf.lipers24.ru/ресурсы/датыУчебногоГрафика#' || ./дата"
                        }
                    },
                    "properties":[
                        {
                            "QName":{
                                "NameSpace":"http://www.w3.org/1999/02/22-rdf-syntax-ns#",
                                "PrefixedName":"rdf:type"
                            },
                            "URI": "https://rdf.lipers24.ru/онтология/ДатаУчебногоГрафика"
                        },
						{
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:дата"
                            },
                            "literal":{
                                "compute":{
                                    "xquery": [
                                        "./дата/text()",
                                        "xs:string(Q{dateTime}dateParse(.))"
                                    ]
                                }
                            }
                        },
                        {
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:деньНедели"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":"./subject/row/cell[@label='День недели']/text()"
                                }
                            }
                        },
                        {
                            "context":{
                                "день":{
                                    "compute":{
                                        "xquery": "./subject/row/cell[@label='День недели']/text()"
                                    }
                                }
                            },
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:номерДняНедели"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":
                                    "Q{dateTime}days(./день/text())"

                                }
                            }
                        },
						{
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:календарныйНомерНедели"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":"./subject/row/cell[@label='Календарный номер недели']/text()"
                                }
                            }
                        },
						{
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:учебныйНомерНедели"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":"./subject/row/cell[@label='Учебный номер недели']/text()"
                                }
                            }
                        },
						{
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:период"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":"./subject/row/cell[@label='Период']/text()"
                                }
                            }
                        },
						{
                            "QName":{
                                "NameSpace":"https://rdf.lipers24.ru/schema/",
                                "PrefixedName":"lipers24:учебныеДни"
                            },
                            "literal":{
                                "compute":{
                                    "xquery":"./subject/row/cell[@label='Учебные дни']/text()"
                                }
                            }
                        }
                    ]
                }
            }
        ]
    }
}
