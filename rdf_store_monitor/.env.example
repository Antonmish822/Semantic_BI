# RDF store connection. Fuseki URL is the dataset endpoint; GraphDB URL is the
# server base URL and GRAPHDB_REPOSITORY selects the repository.
RDF_BACKEND=fuseki
RDF_URL=http://127.0.0.1:3030/Persistent
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=30
GRAPHDB_REPOSITORY=
# Legacy Fuseki variables remain supported; prefer RDF_* above.
# FUSEKI_URL=http://127.0.0.1:3030/Persistent
# FUSEKI_USERNAME=
# FUSEKI_PASSWORD=
# FUSEKI_TIMEOUT=30
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru:
LOADER_STATUS_PATH=/path/to/loader/status.json
S3_BUCKET=
S3_PORTAL_ID=garpix-bitrix24-ru
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
