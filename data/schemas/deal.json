{
  "description": {
    "context": {
      "subject": {
        "compute": {
          "xquery": "/json/object"
        }
      }
    },
    "about": {
      "compute": {
        "xquery": "concat('https://example.org/bitrix24/deal/', ID/text())"
      }
    },
    "properties": [
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:title"
        },
        "literal": {
          "compute": {
            "xquery": "TITLE/text()"
          }
        }
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:createdAt"
        },
        "literal": {
          "compute": {
            "xquery": "DATE_CREATE/text()"
          }
        },
        "datatype": "http://www.w3.org/2001/XMLSchema#dateTime"
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:modifiedAt"
        },
        "literal": {
          "compute": {
            "xquery": "DATE_MODIFY/text()"
          }
        },
        "datatype": "http://www.w3.org/2001/XMLSchema#dateTime"
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:stageCode"
