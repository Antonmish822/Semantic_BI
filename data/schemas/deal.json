      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:opportunity"
        },
        "literal": {
          "compute": {
            "xquery": "OPPORTUNITY/text()"
          }
        },
        "datatype": "http://www.w3.org/2001/XMLSchema#decimal"
