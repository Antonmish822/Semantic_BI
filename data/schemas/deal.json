      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:contact"
        },
        "URI": {
          "compute": {
            "xquery": "concat('https://example.org/bitrix24/contact/', CONTACT_ID/text())"
