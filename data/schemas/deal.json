        }
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:stageSemantic"
        },
        "literal": {
          "compute": {
            "xquery": "STAGE_SEMANTIC_ID/text()"
          }
        }
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:categoryCode"
        },
        "literal": {
          "compute": {
            "xquery": "CATEGORY_ID/text()"
          }
        }
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:sourceCode"
        },
        "literal": {
          "compute": {
            "xquery": "SOURCE_ID/text()"
          }
        }
      },
      {
        "QName": {
          "NameSpace": "https://example.org/bitrix24#",
          "PrefixedName": "b24:beginDate"
        },
        "literal": {
          "compute": {
            "xquery": "BEGINDATE/text()"
          }
        }
